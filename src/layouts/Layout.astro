---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Azeem Ahmad | AI Portfolio",
  description = "Explore the conversational AI portfolio of Azeem Ahmad — Software Developer & Computer Science Student. Interact with verified software projects, experience, skills, and background.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary SEO Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-[#09090b] text-neutral-100 antialiased selection:bg-blue-600/30 selection:text-blue-200">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
