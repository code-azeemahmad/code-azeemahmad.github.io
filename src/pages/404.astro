---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Page Not Found | Azeem Ahmad AI Portfolio">
  <main class="flex min-h-screen w-full flex-col items-center justify-center p-6 text-center bg-canvas text-ink transition-colors">
    <div class="max-w-md rounded-2xl border border-hairline bg-surface-card p-8 shadow-xl shadow-black/5">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-canvas text-primary border border-hairline font-mono text-xl font-semibold">
        404
      </div>
      <h1 class="font-serif text-2xl font-normal text-ink tracking-tight">
        Page Not Found
      </h1>
      <p class="mt-2 text-sm text-muted leading-relaxed">
        The portfolio page or conversation path you requested does not exist or has been moved.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-white hover:bg-primary-active active:bg-primary-active transition-colors shadow-sm"
        >
          Return to Portfolio
        </a>
      </div>
    </div>
  </main>
</Layout>
