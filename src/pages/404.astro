---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Page Not Found | Azeem Ahmad AI Portfolio">
  <main class="flex min-h-screen w-full flex-col items-center justify-center p-6 text-center">
    <div class="max-w-md rounded-2xl border border-neutral-800 bg-neutral-900/60 p-8 shadow-2xl backdrop-blur-sm">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-neutral-800 text-blue-400 border border-neutral-700/60 text-xl font-bold font-mono">
        404
      </div>
      <h1 class="text-2xl font-bold text-neutral-100">Page Not Found</h1>
      <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
        The page you are looking for does not exist or has been moved.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-500 transition-colors shadow-sm"
        >
          Return to Portfolio Assistant
        </a>
      </div>
    </div>
  </main>
</Layout>
