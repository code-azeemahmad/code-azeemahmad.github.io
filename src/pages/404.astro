---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Page Not Found | Azeem Ahmad AI Portfolio">
  <main class="flex min-h-screen w-full flex-col items-center justify-center p-6 text-center bg-[#faf9f5] text-[#141413]">
    <div class="max-w-md rounded-2xl border border-[#e6dfd8] bg-[#efe9de] p-8 shadow-xl shadow-[#141413]/5">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-[#faf9f5] text-[#cc785c] border border-[#e6dfd8] font-mono text-xl font-semibold">
        404
      </div>
      <h1 class="font-serif text-2xl font-normal text-[#141413] tracking-tight">
        Page Not Found
      </h1>
      <p class="mt-2 text-sm text-[#6c6a64] leading-relaxed">
        The portfolio page or conversation path you requested does not exist or has been moved.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-[#cc785c] px-5 py-2.5 text-sm font-medium text-white hover:bg-[#a9583e] active:bg-[#a9583e] transition-colors shadow-sm"
        >
          Return to Portfolio Assistant
        </a>
      </div>
    </div>
  </main>
</Layout>
